# AetherGlobe runs without an environment file.
# Copy this file only when enabling optional local integrations:
#   npm run setup:env
# Never commit .env.local or expose service keys with a VITE_ prefix.

# Optional local dump1090 receiver. Leave blank unless this computer can reach
# the receiver on the same LAN.
DUMP1090_AIRCRAFT_URL=
# Example: http://192.168.0.168/dump1090/data/aircraft.json
DUMP1090_MAX_POSITION_AGE_SECONDS=20

# Optional Aviationstack flight lookup and sampled live-position fallback.
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_TRAFFIC_CACHE_SECONDS=900
AVIATIONSTACK_MAX_LIVE_AGE_SECONDS=1800

# Optional AISstream maritime traffic. This requires the persistent local
# Express runtime or a separate always-on relay; Netlify Functions cannot keep
# the upstream WebSocket continuously connected.
AISSTREAM_API_KEY=
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
AISSTREAM_MAX_POSITION_AGE_SECONDS=300

# Local Express runtime configuration.
PORT=3000
NODE_ENV=development
